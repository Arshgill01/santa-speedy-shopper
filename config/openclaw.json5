// Ultra-lean OpenClaw config for Cerebras x Kimi K3.1 Pro Speed Bounty.
// Strips bundled skills and extra tools so prompt context stays minimal for maximum server decode TPS.
{
  agents: {
    defaults: {
      model: { primary: "cerebras/moonshotai-kimi-k3.1-pro-trial" },
      thinkingDefault: "low",
      models: {
        "cerebras/moonshotai-kimi-k3.1-pro-trial": {
          params: {
            temperature: 1.0,
          },
        },
      },
    },
    entries: {
      main: {
        skills: ["sleigh-shop"],
      },
    },
  },
  models: {
    mode: "merge",
    providers: {
      cerebras: {
        baseUrl: "https://api.cerebras.ai/v1",
        api: "openai-completions",
        apiKey: "${CEREBRAS_API_KEY}",
        models: [
          {
            id: "moonshotai-kimi-k3.1-pro-trial",
            name: "Kimi K3.1 Pro (Cerebras)",
            reasoning: true,
            input: ["text", "image"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            compat: {
              supportsTools: true,
              supportsStrictMode: false,
              supportsReasoningEffort: true,
              supportedReasoningEfforts: ["low", "high", "max"],
            },
          },
        ],
      },
    },
  },
  skills: {
    allowBundled: [],
  },
  tools: {
    profile: "minimal",
    alsoAllow: ["sleigh_shop"],
    deny: ["presence", "session_status"],
    toolSearch: false,
  },
}
